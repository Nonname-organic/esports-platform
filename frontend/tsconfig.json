{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // ユニットテストは jest（next/jest の SWC 変換）で動かす。@types/jest を
    // 入れていないため tsc からは describe / it / expect が未定義に見え、
    // 型チェックの出力が実害のないエラーで埋まる。アプリ本体の型エラーを
    // 読めるようにするため除外する。@types/jest を入れたらこの2行を外す。
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
